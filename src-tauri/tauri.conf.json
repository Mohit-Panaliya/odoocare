{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OdooCARE",
  "version": "1.0.0",
  "identifier": "com.odoocare.analyzer",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../src",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../src",
    "frontendDist": "../src/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OdooCARE",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage", "rpm"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.svg"
    ],
    "publisher": "OdooCARE",
    "copyright": "Copyright © 2026 OdooCARE. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Odoo CE Module Dependency Analyzer — Prevent crashes from untested module installations",
    "longDescription": "A desktop tool that analyzes Odoo Community Edition module ZIP files before installation. It resolves dependency order via topological sort, detects missing Odoo modules, checks internal/external dependencies, identifies undeclared Python imports, and generates detailed reports — so you never crash Odoo after installing untested modules from OCA or third-party sources.",
    "licenseFile": "../LICENSE",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "OdooCARE"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "section": "devel",
        "priority": "optional"
      },
      "rpm": {
        "release": "1",
        "epoch": 0,
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
